# Supabase — from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — from console.anthropic.com
ANTHROPIC_API_KEY=

# Tradovate — from partner.tradovate.com after API access is approved
TRADOVATE_API_URL=https://demo.tradovateapi.com/v1
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SECRET=

# Secret used to encrypt stored Tradovate tokens at rest (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=
